# API Base URL (Use /api for self-contained Next.js Serverless routes on Vercel, or http://localhost:5000/api for standalone Express backend)
NEXT_PUBLIC_API_URL=/api
NEXT_PUBLIC_APP_NAME="InsureShield Agent CRM"

# Database Configuration (MongoDB Atlas connection string)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/insurance_platform?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=super_secret_jwt_key_insurance_agent_platform_2026
JWT_EXPIRES_IN=7d

# Free Gmail SMTP (Sends real emails to ANY customer with 0 domain required)
SMTP_USER=
SMTP_PASS=

# Resend Email (Alternative provider)
RESEND_API_KEY=
EMAIL_FROM=onboarding@resend.dev

# Stripe Payments (Optional - simulation mode active if placeholder)
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder
